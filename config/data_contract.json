    "required_sheets": [
      "METADATOS",
      "DERIVACIONES",
      "CIRUGIAS",
      "ACTIVIDAD_PROF",
      "LISTA_ESPERA_AMB"
    ],
    "legacy_compatible_versions": [
      "1.1.0",
      "1.2.0"
    ],
    "required_sheets_by_contract_version": {
      "1.1.0": [
        "METADATOS",
        "DERIVACIONES",
        "CIRUGIAS",
        "ACTIVIDAD_PROF"
      ],
      "1.2.0": [
        "METADATOS",
        "DERIVACIONES",
        "CIRUGIAS",
        "ACTIVIDAD_PROF",
        "LISTA_ESPERA_AMB"
      ],
      "1.3.0": [
