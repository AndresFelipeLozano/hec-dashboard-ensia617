        {"name": "service_id", "type": "service_id", "required": true, "critical": true},
        {"name": "specialty_id", "type": "specialty_id", "required": false, "critical": false},
        {"name": "origin_establishment_code", "type": "deis_code", "required": true, "critical": true},
        {"name": "referral_type", "type": "enum", "required": true, "critical": true, "allowed_values": ["new", "followup", "teleconsult"]},
        {"name": "status", "type": "enum", "required": true, "critical": true, "allowed_values": ["waiting", "completed", "discharged", "rejected"]},
        {"name": "wait_days", "type": "integer", "required": true, "critical": true, "minimum": 0},
        {"name": "scheduled_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "no_show_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "pertinence_assessment", "type": "enum", "required": true, "critical": true, "allowed_values": ["pertinent", "not_pertinent", "not_assessed"]},
        {"name": "contrareference_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "ges_applicable_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "ges_due_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "ges_met_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "teleconsult_timely_closed_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "documentation_complete_flag", "type": "boolean", "required": true, "critical": true}
      ]
    },
    "CIRUGIAS": {
      "primary_key": "surgery_case_id",
      "service_dashboard_type": "surgical",
      "columns": [
        {"name": "surgery_case_id", "type": "identifier", "required": true, "critical": true, "unique": true},
        {"name": "period_date", "type": "date", "required": true, "critical": true},
        {"name": "service_id", "type": "service_id", "required": true, "critical": true},
        {"name": "specialty_id", "type": "specialty_id", "required": false, "critical": false},
        {"name": "origin_establishment_code", "type": "deis_code", "required": true, "critical": true},
        {"name": "procedure_code", "type": "identifier", "required": true, "critical": true},
        {"name": "status", "type": "enum", "required": true, "critical": true, "allowed_values": ["waitlisted", "completed", "resolved", "suspended"]},
        {"name": "wait_days", "type": "integer", "required": true, "critical": true, "minimum": 0},
        {"name": "elective_major_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "ambulatory_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "scheduled_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "or_hours_used", "type": "number", "required": true, "critical": true, "minimum": 0},
        {"name": "or_hours_available", "type": "number", "required": true, "critical": true, "minimum": 0},
        {"name": "documentation_complete_flag", "type": "boolean", "required": true, "critical": true}
      ]
    },
    "ACTIVIDAD_PROF": {
      "primary_key": "activity_id",
      "columns": [
        {"name": "activity_id", "type": "identifier", "required": true, "critical": true, "unique": true},
        {"name": "period_date", "type": "date", "required": true, "critical": true},
        {"name": "simulated_profile_key", "type": "identifier", "required": true, "critical": true},
        {"name": "profile_type", "type": "enum", "required": true, "critical": true, "allowed_values": ["clinical", "surgical", "mixed"]},
        {"name": "lens", "type": "enum", "required": true, "critical": true, "allowed_values": ["clinical", "surgical"]},
        {"name": "service_id", "type": "service_id", "required": true, "critical": true},
        {"name": "specialty_id", "type": "specialty_id", "required": false, "critical": false},
        {"name": "origin_establishment_code", "type": "deis_code", "required": true, "critical": true},
        {"name": "activity_code", "type": "identifier", "required": true, "critical": true},
        {"name": "scheduled_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "completed_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "no_show_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "suspended_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "new_consultation_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "discharge_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "elective_major_applicable_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "ambulatory_major_flag", "type": "boolean", "required": true, "critical": true},
        {"name": "documentation_complete_flag", "type": "boolean", "required": true, "critical": true}
