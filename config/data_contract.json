        "DERIVACIONES",
        "CIRUGIAS",
        "ACTIVIDAD_PROF",
        "LISTA_ESPERA_AMB"
      ]
    },
    "informational_sheets": [
      "INSTRUCCIONES",
      "CATALOGOS"
    ],
    "date_format": "YYYY-MM-DD",
    "empty_row_policy": "ignore_when_all_cells_are_blank",
    "unknown_sheet_policy": "warn",
    "unknown_column_policy": "reject_workbook",
    "missing_required_sheet_policy": "reject_workbook",
    "missing_required_column_policy": "reject_workbook"
  },
  "dataset_policy": {
    "allowed_source_modes": [
      "simulado"
    ],
    "session_only": true,
    "persist_uploaded_workbooks": false,
    "real_patient_identifiers_allowed": false,
    "real_employee_identifiers_allowed": false,
    "patient_addresses_allowed": false,
    "patient_level_drilldown_allowed": false,
    "professional_profiles_are_simulated": true,
    "unavailable_or_inapplicable_values_render_as_zero": false
  },
  "validation_policy": {
    "structural_error_action": "reject_candidate",
    "row_error_action": "quarantine_row",
    "minimum_accepted_record_pct_for_activation": 95,
    "minimum_accepted_rows_per_data_sheet": 1,
    "critical_fields_must_be_complete_in_accepted_rows": true,
    "duplicates_are_quarantined": true,
    "invalid_dates_are_quarantined": true,
    "invalid_codes_are_quarantined": true,
    "unmatched_deis_origin_codes_are_quarantined": true
  },
  "activation_policy": {
    "candidate_is_separate_from_active": true,
    "explicit_activation_required": true,
    "failed_validation_replaces_active_dataset": false,
    "activation_is_atomic": true,
    "activation_storage": "streamlit_session_state",
    "session_state_is_durable_security_storage": false
  },
  "reference_data": {
    "deis_snapshot_file": "data/reference/deis_establishments_ssmc_snapshot.csv",
    "deis_manifest_file": "data/reference/deis_snapshot_manifest.json",
    "origin_code_field": "origin_establishment_code",
    "minimum_geographic_cell_size": 10,
    "coordinate_policy": "official_establishment_coordinates_only"
    ,"referral_diagnosis_catalog_file": "config/referral_diagnoses.json"
  },
  "metadata_keys": [
    {
      "key": "contract_version",
      "required": true,
      "allowed_values": [
        "1.1.0",
        "1.2.0",
        "1.3.0"
      ]
    },
    {
      "key": "dataset_id",
      "required": true,
      "type": "identifier"
    },
    {
      "key": "dataset_name",
      "required": true,
      "type": "string"
    },
    {
      "key": "source_mode",
      "required": true,
      "allowed_values": [
        "simulado"
      ]
    },
    {
      "key": "period_start",
      "required": true,
      "type": "date"
    },
    {
      "key": "period_end",
      "required": true,
      "type": "date"
    },
    {
      "key": "generated_at_utc",
      "required": true,
      "type": "datetime"
    },
    {
      "key": "simulation_notice_es",
      "required": true,
      "expected_value": "Datos operacionales y perfiles profesionales completamente simulados."
    },
    {
      "key": "deis_snapshot_id",
      "required": true,
      "type": "identifier"
    }
