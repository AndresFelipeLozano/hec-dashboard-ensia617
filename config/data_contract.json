        {"name": "snapshot_date", "type": "date", "required": true, "critical": true},
        {"name": "period_id", "type": "enum", "required": true, "critical": true, "allowed_values": ["2026-Q1", "2026-Q2"]},
        {"name": "queue_type", "type": "enum", "required": true, "critical": true, "allowed_values": ["new_consultation", "followup_control"]},
        {"name": "service_id", "type": "service_id", "required": true, "critical": true},
        {"name": "specialty_id", "type": "specialty_id", "required": true, "critical": true},
        {"name": "referral_diagnosis_id", "type": "identifier", "required": true, "critical": true},
        {"name": "professional_profile_id", "type": "identifier", "required": false, "critical": false},
        {"name": "origin_deis_code", "type": "deis_code", "required": true, "critical": true},
        {"name": "requested_prestation", "type": "enum", "required": true, "critical": true, "allowed_values": ["consulta_nueva", "control_especialidad", "evaluacion_preoperatoria", "procedimiento_ambulatorio"]},
        {"name": "queue_entry_date", "type": "date", "required": false, "critical": false},
        {"name": "control_due_date", "type": "date", "required": false, "critical": false},
        {"name": "scheduled_date", "type": "date", "required": false, "critical": false},
        {"name": "completion_date", "type": "date", "required": false, "critical": false},
        {"name": "episode_status", "type": "enum", "required": true, "critical": true, "allowed_values": ["open_unscheduled", "open_scheduled", "completed", "exited"]},
        {"name": "exit_reason", "type": "enum", "required": false, "critical": false, "allowed_values": ["clinical_exit", "duplicate", "declined", "other_valid"]},
        {"name": "priority_class", "type": "enum", "required": true, "critical": true, "allowed_values": ["routine", "preferential", "urgent"]},
        {"name": "simulated_flag", "type": "boolean", "required": true, "critical": true}
      ]
    }
  },
  "cross_field_rules": [
    "period_date must fall within metadata period_start and period_end",
    "specialty_id, when present, must belong to service_id",
    "service_id must be MVP-enabled and match the sheet or professional lens",
    "origin_establishment_code must exist in the packaged DEIS snapshot",
    "no_show_flag requires scheduled_flag",
    "ges_met_flag requires ges_due_flag",
    "ambulatory_flag requires elective_major_flag",
    "or_hours_used cannot exceed or_hours_available",
    "ambulatory_major_flag requires elective_major_applicable_flag",
    "clinical professional rows cannot be marked suspended, elective-major applicable, or ambulatory major",
    "surgical professional rows cannot be marked no-show, new consultation, or discharge",
    "mixed profiles are represented through separate clinical and surgical rows",
    "snapshot_date must fall within metadata period_start and period_end",
    "period_id must match the quarter containing snapshot_date",
    "new-consultation episodes require queue_entry_date and cannot use control_due_date",
    "follow-up-control episodes require control_due_date and cannot use queue_entry_date",
    "completed episodes require completion_date; open and exited episodes cannot have completion_date",
    "open_scheduled episodes require scheduled_date; open_unscheduled episodes cannot have scheduled_date",
    "exited episodes require exit_reason and other statuses cannot have exit_reason",
    "professional_profile_id, when present, must match the episode specialty",
    "referral_diagnosis_id must exist, remain explicitly simulated, and match specialty_id",
    "all LISTA_ESPERA_AMB rows must be explicitly simulated"
  ]
}
